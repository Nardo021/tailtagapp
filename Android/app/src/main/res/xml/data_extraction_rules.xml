<?xml version="1.0" encoding="utf-8"?><!--
   Empty cloud-backup keeps Android's default, which includes shared preferences and files.
   Photo JSON stores file names inside spotting_photos so a restored files directory still resolves.
   The device-transfer section stays unset so transfer follows the cloud-backup rules.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>
